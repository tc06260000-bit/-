{
  "manifest_version": 3,
  "name": "ChatGPT 分享原文核对（普通聊天）",
  "version": "1.1.0",
  "description": "自动补入分享原文，并核对回复中的消息编号、原句和条数；空闲时静默，发现可疑不一致再提示。",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "核对最近的分享链接回复",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["core.js", "diagnostics.js", "audit.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
